# ──────────────────────────────────────────────────────────────
# Awkward Recovery Landing Page — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# These same values must be added as Vercel Environment Variables.
# ──────────────────────────────────────────────────────────────

# Gmail SMTP (used by Nodemailer to forward form leads)
# ─────────────────────────────────────────────────────
# Use a Google Workspace or Gmail account.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2FA to be enabled on the account)
SMTP_USER=info@awkwardrecovery.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Recipient email(s) for lead notifications
# ─────────────────────────────────────────
# Comma-separated list of emails that will receive form submissions.
# These should be the in-house admissions/intake staff at Awkward Recovery.
CONTACT_EMAIL=info@awkwardrecovery.com

# Google Tag Manager (optional)
# ─────────────────────────────
# GTM_ID=GTM-XXXXXXX

# Google Analytics 4 (optional)
# ─────────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
